<mvc:View
    controllerName="odatacrud.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <Table
            id="idProducts"
            items="{/Products}"
        ><!--items="{/results}"-->
            <columns>
                <Column>
                    <Text text="ID" />
                </Column>
                <Column>
                    <Text text="Name" />
                </Column>
                <Column>
                    <Text text="Price" />
                </Column>
                <Column>
                    <Text text="Rating" />
                </Column>
                <Column >
                    <Text />
                </Column>
            </columns>

            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{ID}" />
                        <Text text="{Name}" />
                        <Text text="{Price}" />
                        <Input
                            value="{Rating}"
                            editable="false"
                        />
                        <HBox>
                            <Button
                                icon="sap-icon://edit"
                                text="Edit"
                                press="onEdit"
                            />
                            <Button
                                class="sapUiSmallMarginBeginEnd"
                                type="Reject"
                                icon="sap-icon://delete"
                                text="Delete"
                                press="onDelete"
                            />
                            <Button
                                icon="sap-icon://copy"
                                text="Duplicate"
                                press="onDuplicate"
                            />
                        </HBox>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>
